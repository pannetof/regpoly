{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "regpoly (with Python extension)",
      "binaryDir": "${sourceDir}/../build",
      "cacheVariables": { "REGPOLY_BUILD_TESTS": "ON" }
    },
    {
      "name": "cpp-only",
      "displayName": "regpoly pure C++ (no pybind11 / Python)",
      "binaryDir": "${sourceDir}/../build-cpp",
      "cacheVariables": {
        "REGPOLY_BUILD_PYTHON_EXTENSION": "OFF",
        "REGPOLY_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "cpp-only", "configurePreset": "cpp-only" }
  ],
  "testPresets": [
    { "name": "cpp-only", "configurePreset": "cpp-only", "output": { "outputOnFailure": true } }
  ]
}
